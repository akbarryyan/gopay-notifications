# Salin ke .env.dev (diabaikan git), lalu isi DEVICE_SECRET_KEY,
# ADMIN_SESSION_KEY, WEBHOOK_SECRET_KEY, dan VENDOR_SESSION_KEY.
#
#   cp .env.dev.example .env.dev
#   echo "DEVICE_SECRET_KEY=$(go run ./cmd/devicetool -genkey)" >> .env.dev
#   echo "ADMIN_SESSION_KEY=$(go run ./cmd/devicetool -genkey)" >> .env.dev
#   echo "WEBHOOK_SECRET_KEY=$(go run ./cmd/devicetool -genkey)" >> .env.dev
#   echo "VENDOR_SESSION_KEY=$(go run ./cmd/devicetool -genkey)" >> .env.dev

DATABASE_URL=postgres://gopay:gopay@localhost:5433/gopay_dev?sslmode=disable

# 0.0.0.0 WAJIB, bukan 127.0.0.1. HP di LAN tidak akan pernah bisa menghubungi
# server yang hanya mengikat ke localhost.
#
# 8090, bukan 8080: port 8080 dan 8081 sering sudah dipakai project lain di
# mesin ini. `make run-dev` memeriksanya dan berhenti dengan pesan jelas bila
# bentrok, alih-alih mati diam-diam dan membiarkan HP bicara ke aplikasi lain.
LISTEN_ADDR=0.0.0.0:8090

# Harus TETAP antar restart. Kunci baru membuat secret device yang sudah
# tersimpan tidak dapat didekripsi, dan device harus dibuat ulang tiap kali.
DEVICE_SECRET_KEY=

# Menandatangani cookie sesi dashboard admin. Terpisah dari DEVICE_SECRET_KEY
# — keduanya melindungi hal yang berbeda, jangan memakai nilai yang sama.
# Kunci baru membuat seluruh sesi yang sedang login otomatis logout, tapi
# tidak menghapus data apa pun.
ADMIN_SESSION_KEY=

# Mengenkripsi secret webhook (bukan menandatangani seperti dua kunci di
# atas) — dipakai ulang tiap kali backend mengirim payload keluar ke
# merchant. Kunci ketiga: jangan pernah memakai nilai yang sama dengan
# DEVICE_SECRET_KEY atau ADMIN_SESSION_KEY. Kunci baru membuat seluruh
# webhook yang sudah terdaftar tidak bisa didekripsi lagi secret-nya — harus
# dibuat ulang lewat dashboard.
WEBHOOK_SECRET_KEY=

# Menandatangani cookie sesi Vendor Dashboard (vendor_session) -- terpisah
# dari ADMIN_SESSION_KEY di atas (sesi customer, admin_session), supaya dua
# jenis sesi ini tidak mungkin tertukar walau di browser yang sama.
VENDOR_SESSION_KEY=