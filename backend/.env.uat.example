# Salin ke /opt/gopay-ingestion-uat/.env lalu isi.
# WAJIB berbeda dari produksi — database, port, dan kunci enkripsi.
DATABASE_URL=postgres://gopay_uat:GANTI_PASSWORD@localhost:5432/gopay_uat?sslmode=disable
LISTEN_ADDR=127.0.0.1:8081

# Hasilkan TERPISAH dari produksi: go run ./cmd/devicetool -genkey
# Memakai kunci yang sama membuat batas antara UAT dan produksi jadi semu.
DEVICE_SECRET_KEY=

# Sesi dashboard admin UAT. Juga wajib terpisah dari produksi.
ADMIN_SESSION_KEY=

# Enkripsi secret webhook UAT. Juga wajib terpisah dari produksi dan dari
# dua kunci di atas.
WEBHOOK_SECRET_KEY=

# Vendor Dashboard tidak dijalankan di instalasi UAT ini -- endpoint
# /api/v1/vendor/* tetap terdaftar di binary yang sama, jadi kuncinya tetap
# wajib diisi (beda dari produksi), tapi tidak ada yang benar-benar
# memakainya di UAT.
VENDOR_SESSION_KEY=
