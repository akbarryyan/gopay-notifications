# Salin ke .env di VPS lalu isi. Jangan pernah commit .env yang sudah terisi.
DATABASE_URL=postgres://gopay:GANTI_PASSWORD@localhost:5432/gopay?sslmode=disable
LISTEN_ADDR=127.0.0.1:8080

# Hasilkan dengan: go run ./cmd/devicetool -genkey
# Mengganti nilai ini membuat seluruh secret device yang tersimpan tidak dapat didekripsi.
DEVICE_SECRET_KEY=

# Menandatangani cookie sesi dashboard admin. Hasilkan TERPISAH dari
# DEVICE_SECRET_KEY dengan perintah yang sama: go run ./cmd/devicetool -genkey
# Jangan memakai nilai yang sama untuk keduanya.
ADMIN_SESSION_KEY=

# Mengenkripsi secret webhook. Hasilkan TERPISAH lagi dengan perintah yang
# sama: go run ./cmd/devicetool -genkey. Kunci ketiga, jangan pernah sama
# dengan dua di atas.
WEBHOOK_SECRET_KEY=

# Lisensi (lihat backend/deploy/README.md §"Lisensi"). Kosongkan
# LICENSE_KEY sampai vendor mengirim key -- instalasi tetap menyala tapi
# seluruh endpoint device/admin/API key menjawab 402 sampai diisi.
LICENSE_KEY=
# "production" atau "uat" -- wajib diisi begitu LICENSE_KEY diisi.
ENVIRONMENT=production
# Opsional, default https://license.whuzpay.com
LICENSE_SERVER_URL=
# Opsional -- path local license state (ditulis OTOMATIS, jangan diedit
# manual). Default: /opt/gopay-ingestion/license-state.lic
LICENSE_FILE_PATH=
