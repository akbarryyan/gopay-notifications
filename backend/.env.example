# Salin ke .env di VPS lalu isi. Jangan pernah commit .env yang sudah terisi.
DATABASE_URL=postgres://gopay:GANTI_PASSWORD@localhost:5432/gopay?sslmode=disable
LISTEN_ADDR=127.0.0.1:8080

# Hasilkan dengan: go run ./cmd/devicetool -genkey
# Mengganti nilai ini membuat seluruh secret device yang tersimpan tidak dapat didekripsi.
DEVICE_SECRET_KEY=

# Menandatangani cookie sesi dashboard admin (akun customer, admin_session).
# Hasilkan TERPISAH dari DEVICE_SECRET_KEY dengan perintah yang sama:
# go run ./cmd/devicetool -genkey. Jangan memakai nilai yang sama untuk keduanya.
ADMIN_SESSION_KEY=

# Mengenkripsi secret webhook. Hasilkan TERPISAH lagi dengan perintah yang
# sama: go run ./cmd/devicetool -genkey. Kunci ketiga, jangan pernah sama
# dengan dua di atas.
WEBHOOK_SECRET_KEY=

# Menandatangani cookie sesi Vendor Dashboard (vendor_session) -- TERPISAH
# dari ADMIN_SESSION_KEY di atas, supaya sesi vendor (Akbar) dan sesi
# customer tidak mungkin tertukar walau tersimpan di browser yang sama.
# Hasilkan dengan perintah yang sama: go run ./cmd/devicetool -genkey.
VENDOR_SESSION_KEY=
