# Produksi
GANTI-DOMAIN.com {
	encode zstd gzip

	# GET /api/v1/events (debug manual M2/M4) sudah DIHAPUS dari backend saat
	# migrasi multi-tenant (lihat docs/api-contract.md §7) -- blok basic_auth
	# yang dulu menjaganya di sini SUDAH DIHAPUS JUGA. Wildcard-nya dulu ikut
	# memblokir POST /api/v1/events (device ingestion HMAC yang sungguhan)
	# sebelum sampai ke backend, karena Caddy path matcher tidak peduli method.
	# Jangan tambahkan lagi tanpa scope `method GET` eksplisit.
	@api path /api/*
	handle @api {
		reverse_proxy 127.0.0.1:8080
	}

	# Apa pun selain /api/* ke dashboard Next.js — satu origin, tanpa CORS,
	# persis seperti yang diasumsikan dashboard/README.md dan
	# dashboard/src/proxy.ts.
	handle {
		reverse_proxy 127.0.0.1:3000
	}

	log {
		output file /var/log/caddy/gopay.log
		format json
	}
}

# UAT — layanan, database, dan DEVICE_SECRET_KEY terpisah dari produksi.
# Dashboard UAT belum dipasang di sini — tambahkan blok "handle" yang sama
# dengan port dashboard UAT-nya sendiri (mis. 127.0.0.1:3001) kalau nanti
# dibutuhkan.
uat.GANTI-DOMAIN.com {
	encode zstd gzip

	reverse_proxy 127.0.0.1:8081

	log {
		output file /var/log/caddy/gopay-uat.log
		format json
	}
}
