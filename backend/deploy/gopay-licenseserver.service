[Unit]
Description=GoPay License Server (vendor-only)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=gopay-license
Group=gopay-license
WorkingDirectory=/opt/gopay-license
EnvironmentFile=/opt/gopay-license/.env
ExecStart=/opt/gopay-license/licenseserver
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/gopay-license

[Install]
WantedBy=multi-user.target
