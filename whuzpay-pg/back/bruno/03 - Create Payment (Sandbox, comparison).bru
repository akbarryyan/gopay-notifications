meta {
  name: 03 - Create Payment (Sandbox, comparison)
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/admin/payments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "merchant_id": "{{merchant_id}}",
    "amount": 50000,
    "description": "Bruno test - sandbox (never touches gopay-notifications)",
    "payment_method": "qris",
    "environment": "sandbox"
  }
}

tests {
  test("payment created via sandbox mock", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.body.provider_name).to.equal("sandbox");
  });
}

docs {
  Sama seperti request produksi (payment_method: qris), cuma "environment"
  diganti sandbox. Run ini untuk melihat kontrasnya: provider_name balik
  "sandbox", dan log backend menunjukkan "Creating SANDBOX payment (mock
  provider, no gopay call)" -- sandbox tidak pernah menyentuh
  gopay-notifications sama sekali.
}
