node_modules/
.expo/
*.apk
*.keystore
.env
.env.*
!.env.example
backend/bin/
tmp/
.DS_Store

# Hanya folder hasil prebuild yang diabaikan. Jangan pakai pola "android/"
# telanjang — itu cocok dengan direktori bernama android di level mana pun,
# termasuk mobile/modules/<nama>/android/ yang berisi kode Kotlin dan WAJIB
# ikut ter-commit.
/mobile/android/
/mobile/ios/

# Artefak build gradle di dalam local module. Pola diakhiri "/" supaya hanya
# direktori yang cocok — berkas build.gradle tetap ter-track.
/mobile/modules/*/android/build/
/mobile/modules/*/android/.gradle/
