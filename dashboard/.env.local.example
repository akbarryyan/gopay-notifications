# Salin ke .env.local (diabaikan git). Hanya dipakai saat `npm run dev` di
# laptop — di produksi Caddy yang merutekan /api/* ke backend, jadi variabel
# ini tidak pernah dibaca sama sekali di sana.
#
#   cp .env.local.example .env.local

# Alamat backend Go lokal. Sesuaikan port dengan LISTEN_ADDR di
# backend/.env.dev (lihat `make dev-url` di folder backend/).
BACKEND_URL=http://localhost:8090
